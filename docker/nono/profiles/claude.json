{
  "extends": "nolabs-ai/claude",
  "meta": {
    "name": "claude",
    "version": "1.0.0",
    "description": "CLIProxyAPI in Docker: nono sandbox with filtered egress and container data paths."
  },
  "filesystem": {
    "allow": [
      "/CLIProxyAPI",
      "/root/.cli-proxy-api"
    ]
  },
  "network": {
    "network_profile": "developer",
    "allow_domain": [
    ],
    "listen_port": [8317, 8085, 1455, 54545, 51121, 11451]
  }
}
